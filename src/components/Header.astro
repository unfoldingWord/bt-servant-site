---
import { WEB_APP_LOGIN_URL } from '../data/site';
interface Props { anchorBase: string }
const { anchorBase } = Astro.props;
---
<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a class="site-logo" href="/" aria-label="BT Servant home">
      <img class="site-logo__full" src="/assets/images/logo-full.png" alt="BT Servant" />
    </a>
    <nav class="site-nav" id="siteNav" aria-label="Primary">
      <ul class="nav-menu">
        <li><a href={`${anchorBase}#what-you-can-do`}>What You Can Do</a></li>
        <li><a href={`${anchorBase}#where-to-use-it`}>Where to Use It</a></li>
        <li><a href={`${anchorBase}#why-bt-servant`}>Why BT Servant</a></li>
        <li><a href="/organizations/">Organizations</a></li>
      </ul>
    </nav>
    <div class="site-header__cta">
      <a href={WEB_APP_LOGIN_URL} class="btn btn--navy btn--sm" data-track="header_cta" data-track-name="start_conversation">Start a Conversation</a>
    </div>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="siteNav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
