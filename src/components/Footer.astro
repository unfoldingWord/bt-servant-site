---
import { WEB_APP_URL, GITHUB_URL, DISCORD_URL, DEMO_VIDEO_URL, CONTACT_URL, RELEASES_URL } from '../data/site';
import { localePath, formatDate } from '../i18n/config';
interface Props { locale: string; ui: any; anchorBase: string; updated: string }
const { locale, ui, anchorBase, updated } = Astro.props;
// "Last updated {date}": the date is a <time> element, written out in the
// locale (the same PAGE_UPDATED date as the page's WebPage dateModified).
const credit = ui.footer.credit.replace('{date}', `<time datetime="${updated}">${formatDate(updated, locale)}</time>`);
---
<footer class="site-footer" role="contentinfo" id="about">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-logo" href={localePath(locale, 'home')}>
        <img class="site-logo__full" src="/assets/images/logo-full-inverse.png" alt="BT Servant" />
      </a>
      <p class="site-footer__tag" set:html={ui.footer.tagline} />
    </div>

    <div class="site-footer__cols">
      <div class="site-footer__col">
        <h5 set:html={ui.footer.access} />
        <a href={`${anchorBase}#where-to-use-it`}>WhatsApp</a>
        <a href={`${anchorBase}#where-to-use-it`}>Telegram</a>
        <a href={`${anchorBase}#where-to-use-it`}>Signal</a>
        <a href={WEB_APP_URL} set:html={ui.footer.webApp} />
      </div>
      <div class="site-footer__col">
        <h5 set:html={ui.footer.resources} />
        <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
        <a href={DISCORD_URL} target="_blank" rel="noopener">Discord</a>
        <a href={DEMO_VIDEO_URL} target="_blank" rel="noopener" set:html={ui.footer.demoVideo} />
        <a href={CONTACT_URL} target="_blank" rel="noopener" set:html={ui.footer.contact} />
      </div>
    </div>
  </div>

  <div class="site-footer__credits">
    <div class="container">
      <span set:html={credit} />
      <span><Fragment set:html={ui.footer.openSource} /> &middot; <a href={RELEASES_URL} target="_blank" rel="noopener" set:html={ui.footer.releaseNotes} /></span>
    </div>
  </div>
</footer>
