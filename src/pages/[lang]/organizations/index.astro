---
import OrganizationsPage from '../../../components/pages/OrganizationsPage.astro';
import { locales, defaultLocale } from '../../../i18n/config';

export function getStaticPaths() {
  return locales.filter((l) => l.code !== defaultLocale).map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
---
<OrganizationsPage locale={lang!} />
