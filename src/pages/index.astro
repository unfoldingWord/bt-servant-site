---
// Home page. Markup carried over verbatim from the static site's index.html
// (asset paths made root-absolute). Shared copy for /llms.txt etc. lives in
// src/data/site.ts.
import Base from '../layouts/Base.astro';
---
<Base pageKey="home" bodyClass="home">

  <!-- ============================================================ -->
  <!-- 1. HERO -->
  <!-- ============================================================ -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 class="hero__title">BT Servant equips disciples</h1>
        <p class="hero__rotator" aria-live="polite"><span class="hero__rotator-text" id="heroRotator">to understand</span><span class="caret" aria-hidden="true"></span> <span class="hero__rotator-tail">God&rsquo;s Word.</span></p>
        <p class="hero__sub">Ask in text or voice. Get trusted, context-aware guidance &mdash; inside the apps you already use.</p>
        <div class="hero__actions">
          <a href="https://wa.me/15558196461?text=Hello%2C%20BT%20Servant" class="btn btn--navy" data-track="hero_cta" data-track-name="start_whatsapp">Start on WhatsApp</a>
          <a href="https://app.btservant.ai/chat" class="btn btn--ghost" data-track="hero_cta" data-track-name="open_webapp">Open the Web App</a>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="chat-shot">
          <img src="/assets/images/wa/understand.png" alt="A real WhatsApp conversation with BT Servant: a user asks for help understanding Romans 12:1-2, and BT Servant replies with the passage text and translation notes." loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 2. REACH -->
  <!-- ============================================================ -->
  <section class="reach" id="where-to-use-it">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="section-title reach__title">Available wherever you serve.</h2>
        <p class="section-sub reach__sub">Free, in the apps you already know.</p>
      </div>

      <div class="reach__mobile-actions">
        <a href="https://wa.me/15558196461?text=Hello%2C%20BT%20Servant" class="btn btn--navy" data-track="reach_mobile" data-track-name="whatsapp">Open in WhatsApp</a>
        <a href="https://t.me/bt_servant_bot" class="btn btn--ghost" data-track="reach_mobile" data-track-name="telegram">Open in Telegram</a>
        <a href="https://signal.me/#eu/-RGNTp_ER2U74QlijVSyUHxU_EnzcvATLyvcTyCYS8r_jcbr-FlNxJcgZ7fPXTce" class="btn btn--ghost" data-track="reach_mobile" data-track-name="signal">Open in Signal</a>
        <a href="https://app.btservant.ai/chat" class="btn btn--bronze" data-track="reach_mobile" data-track-name="web">Open Web App</a>
      </div>

      <div class="reach__desktop" id="reachDesktop">
        <div class="reach__tabs" role="tablist" aria-label="Choose a platform">
          <button class="reach__tab is-active" data-channel="whatsapp" role="tab" aria-selected="true" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 3.5A11 11 0 003.2 17.2L2 22l4.9-1.3A11 11 0 1020.5 3.5z"/></svg>
            WhatsApp
          </button>
          <button class="reach__tab" data-channel="telegram" role="tab" aria-selected="false" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12l19-8-6 18-5-6-6-2z"/></svg>
            Telegram
          </button>
          <button class="reach__tab" data-channel="signal" role="tab" aria-selected="false" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="3 2.4"/><circle cx="12" cy="12" r="4.5"/></svg>
            Signal
          </button>
          <button class="reach__tab" data-channel="web" role="tab" aria-selected="false" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18"/></svg>
            Web App
          </button>
        </div>

        <div class="reach__panel" id="reachPanel">
          <div class="reach__steps-wrap">
            <h3 id="reachHeading">Use BT Servant on WhatsApp</h3>
            <ol class="wa-steps" id="reachSteps"></ol>
            <p class="reach__note" id="reachNote"></p>
            <div class="reach__panel-actions">
              <a class="btn btn--navy" id="reachCta" href="https://wa.me/15558196461?text=Hello%2C%20BT%20Servant" data-track="reach_cta" data-track-name="whatsapp">Open in WhatsApp</a>
              <button class="btn btn--ghost" id="reachCopyLink" type="button">Copy access link</button>
            </div>
          </div>
          <div class="reach__qr">
            <img id="reachQrImg" src="/assets/images/qr-code.png" alt="Scan to open BT Servant on WhatsApp" width="210" height="210" loading="lazy" />
            <span>Scan to open</span>
          </div>
        </div>
      </div>

      <p class="reach__langs">English &middot; Indonesian &middot; Spanish &middot; <em>and many more languages</em> &middot; Audio supported</p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 3. INTENTS -->
  <!-- ============================================================ -->
  <section class="intents" id="what-you-can-do">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="section-title">What would you like to do today?</h2>
        <p class="section-sub">Pick a starting point. The rest is a conversation.</p>
      </div>

      <div class="intents__layout">
        <div class="intents__list" role="tablist" aria-label="Choose what you'd like to do">
          <button class="intent-btn is-active" data-intent="understand" role="tab" aria-selected="true" type="button">
            <span class="intent-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></span>
            <span class="intent-btn__text"><strong>Understand</strong><span>What a passage means.</span></span>
          </button>
          <button class="intent-btn" data-intent="study" role="tab" aria-selected="false" type="button">
            <span class="intent-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5h7v15H4a1 1 0 01-1-1V6a1 1 0 011-1z"/><path d="M20 5h-7v15h7a1 1 0 001-1V6a1 1 0 00-1-1z"/></svg></span>
            <span class="intent-btn__text"><strong>Study</strong><span>Context, questions, resources.</span></span>
          </button>
          <button class="intent-btn" data-intent="teach" role="tab" aria-selected="false" type="button">
            <span class="intent-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5h14v10H8l-4 4V5z"/><path d="M21 9v8l-3-3h-4"/></svg></span>
            <span class="intent-btn__text"><strong>Teach</strong><span>Lessons and discussions.</span></span>
          </button>
          <button class="intent-btn" data-intent="translate" role="tab" aria-selected="false" type="button">
            <span class="intent-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18"/></svg></span>
            <span class="intent-btn__text"><strong>Translate</strong><span>Terms, meaning, decisions.</span></span>
          </button>
          <button class="intent-btn" data-intent="share" role="tab" aria-selected="false" type="button">
            <span class="intent-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.5 3.5A11 11 0 003.2 17.2L2 22l4.9-1.3A11 11 0 1020.5 3.5z"/></svg></span>
            <span class="intent-btn__text"><strong>Share</strong><span>The gospel, said clearly.</span></span>
          </button>
          <button class="intent-btn" data-intent="equip" role="tab" aria-selected="false" type="button">
            <span class="intent-btn__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15 8h5M17.5 5.5v5"/></svg></span>
            <span class="intent-btn__text"><strong>Equip</strong><span>Train and multiply leaders.</span></span>
          </button>
        </div>

        <div class="intents__preview" id="intentPreview" data-intent="understand">
          <div class="chat-shot">
            <img id="intentPreviewImg" src="/assets/images/wa/understand.png" alt="A real WhatsApp conversation with BT Servant: a user asks for help understanding Romans 12:1-2, and BT Servant replies with the passage text and translation notes." loading="lazy" />
          </div>
          <div class="intents__preview-actions">
            <a href="https://app.btservant.ai/chat?intent=understand" class="btn btn--bronze" id="intentPreviewCta" data-track="intent_cta" data-track-name="understand">Start understanding</a>
            <div class="intents__preview-continue">
              <span>Continue on:</span>
              <a href="https://wa.me/15558196461?text=Hello%2C%20BT%20Servant" data-track="intent_continue" data-track-name="whatsapp">WhatsApp</a>
              <a href="https://t.me/bt_servant_bot" data-track="intent_continue" data-track-name="telegram">Telegram</a>
              <a href="https://app.btservant.ai/chat" data-track="intent_continue" data-track-name="web">Web</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 5. WHY BT SERVANT -->
  <!-- ============================================================ -->
  <section class="why section--vellum" id="why-bt-servant">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="section-title">Guidance you can trust</h2>
      </div>

      <div class="why__grid">
        <div class="why-card">
          <h4>Trusted</h4>
          <p>Grounded in vetted biblical resources &mdash; not the open internet.</p>
        </div>

        <div class="why-card">
          <h4>Natural</h4>
          <p>Text or voice. No commands to learn.</p>
        </div>

        <div class="why-card">
          <h4>Human-centered</h4>
          <p>Supports pastors, teachers, and translators. Never replaces them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 7. PARTNERS -->
  <!-- ============================================================ -->
  <section class="partners section--vellum" id="partners" style="padding-bottom: 60px;">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="section-title">Built with ministries. Shaped by real use.</h2>
      </div>
    </div>
    <div class="partner-bar">
      <div class="container partner-banner">
        <a class="partner-banner__logo" href="https://www.unfoldingword.org/" target="_blank" rel="noopener">
          <img src="/assets/images/partners/unfoldingword.png" alt="unfoldingWord" loading="lazy" />
        </a>
        <a class="partner-banner__logo" href="https://www.etenlab.org" target="_blank" rel="noopener">
          <img src="/assets/images/partners/eten-innovation-lab.png" alt="ETEN Innovation Lab" loading="lazy" />
        </a>
        <a class="partner-banner__logo" href="https://www.wordcollective.com/" target="_blank" rel="noopener">
          <img src="/assets/images/partners/word-collective.png" alt="Word Collective" loading="lazy" />
        </a>
        <a class="partner-banner__logo" href="https://spoken.org/" target="_blank" rel="noopener">
          <img src="/assets/images/partners/spoken-worldwide.png" alt="Spoken Worldwide" loading="lazy" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 8. FINAL CTA -->
  <!-- ============================================================ -->
  <section class="cta-banner" id="get-started">
    <div class="container cta-banner__inner">
      <h2 class="cta-banner__title">What would you like to do next?</h2>

      <div class="cta-banner__group">
        <span class="cta-banner__group-label">Individuals</span>
        <div class="cta-banner__actions">
          <a href="https://wa.me/15558196461?text=Hello%2C%20BT%20Servant" class="btn btn--bronze" data-track="final_cta" data-track-name="whatsapp">Start on WhatsApp</a>
          <a href="https://t.me/bt_servant_bot" class="btn btn--outline-light" data-track="final_cta" data-track-name="telegram">Telegram</a>
          <a href="https://signal.me/#eu/-RGNTp_ER2U74QlijVSyUHxU_EnzcvATLyvcTyCYS8r_jcbr-FlNxJcgZ7fPXTce" class="btn btn--outline-light" data-track="final_cta" data-track-name="signal">Signal</a>
          <a href="https://app.btservant.ai/chat" class="btn btn--outline-light" data-track="final_cta" data-track-name="web">Web App</a>
        </div>
      </div>
      <div class="cta-banner__group">
        <span class="cta-banner__group-label">Organizations</span>
        <div class="cta-banner__actions">
          <a href="https://app.btservant.ai" class="btn btn--outline-light">Use it with your team</a>
          <a href="https://unfoldingword.org/contact/" class="btn btn--outline-light" target="_blank" rel="noopener">Customize</a>
          <a href="https://unfoldingword.org/contact/" class="btn btn--outline-light" target="_blank" rel="noopener">Integrate</a>
        </div>
      </div>

      <p class="cta-banner__brandline">Ask naturally. Receive trusted guidance. Take action with confidence.</p>
    </div>
  </section>

</Base>
