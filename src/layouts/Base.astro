---
// Shared page shell (the same contract as translationcore.com's Base.astro,
// without the localization). The markup inside <body> is the hand-written
// BT Servant design, carried over verbatim from the static site.
//
// Props:
//   pageKey   — 'home' | 'organizations' (from src/data/site.ts): drives the
//               title, description, canonical and "Last updated" date
//   bodyClass — the original <body class> ("home" or "page")
//   jsonLd    — extra JSON-LD nodes merged into the page's single @graph
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { page, PAGE_UPDATED, PRODUCT_NAME, PUBLISHER_NAME, RELEASES_FEED_URL, type PageKey } from '../data/site';
import { organizationNode, websiteNode, appNode, webPageNode, serializeGraph } from '../lib/jsonld';

interface Props {
  pageKey: PageKey;
  bodyClass: string;
  jsonLd?: unknown[];
}

const { pageKey, bodyClass, jsonLd = [] } = Astro.props;
const { path, title, description } = page(pageKey);
const updated = PAGE_UPDATED[pageKey];
const isHome = pageKey === 'home';
// In-page anchors (#where-to-use-it …) live on the home page.
const anchorBase = isHome ? '' : '/';

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/assets/images/og-image.png', Astro.site).href;
const graph = serializeGraph([
  organizationNode(),
  websiteNode(),
  appNode(),
  webPageNode(canonical, title, description, updated),
  ...jsonLd,
]);
---
<!DOCTYPE html>
<html lang="en" data-theme="carbon">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={PUBLISHER_NAME} />
<meta name="theme-color" content="#23282C" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={PRODUCT_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="BT Servant — trusted Scripture guidance through conversation" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="alternate" type="application/atom+xml" title="BT Servant engine releases" href={RELEASES_FEED_URL} />
<link rel="alternate" type="text/markdown" title="BT Servant — summary for AI agents" href="/llms.txt" />
<script type="application/ld+json" set:html={graph} />

<link rel="icon" type="image/png" href="/assets/images/favicon.png" />
<link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Inter:wght@400;500;600;700;800&display=swap" />

<link rel="stylesheet" href="/assets/css/main.css" />

<GoogleAnalytics />
</head>

<body class={bodyClass}>

<a class="skip-link" href="#site-content">Skip to content</a>

<Header anchorBase={anchorBase} />

<main id="site-content">
<slot />
</main>

<MobileBar anchorBase={anchorBase} />

<Footer anchorBase={anchorBase} updated={updated} />

<script is:inline src="/assets/js/main.js"></script>
</body>
</html>
